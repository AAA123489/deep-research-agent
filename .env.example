# 复制成 .env 再填上真值。
# .env 已经在 .gitignore 里，不会被提交；别把 key 写进任何会被提交的文件。
#
# 放在仓库根目录或 backend/ 都行，backend/.env 优先。
# 终端里已经设过的同名变量优先级更高 —— 想临时换 key 不用改这个文件。

LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/v1

# 推理模型（比如 deepseek-v4-flash）的思考过程也占 max_tokens。
# 如果报「模型没有返回内容（finish_reason=length）」，把这个调大。
# LLM_MAX_TOKENS=3000
